# 复制为 .env 后 docker compose 默认会自动读取
# 必填！部署时必须改成真实地址，否则抓图页连不上 Lychee。
# 本版本对应 Lychee v4.13.0（compose 网络 lychee-v4_default）：
LYCHEE_URL=http://lychee-v4:80
LYCHEE_TOKEN=
UPLOAD_METHOD=multipart
MAX_IMAGES=200
MAX_VIDEO_BYTES=524288000
BLOCK_PRIVATE_NETWORKS=true
PORT=8101
# 相册图片管理面板：单次最多显示张数 / 单次最多删除张数
ALBUM_MANAGE_LIMIT=800
ALBUM_DELETE_LIMIT=1000
# 本地上传（网页端「📷 上传本地图片」）单文件大小上限（字节）
MAX_LOCAL_IMAGE_BYTES=20971520
MAX_LOCAL_VIDEO_BYTES=104857600
